@echo off
setlocal
cd /d "%~dp0"
echo OpenSayo v1.15 - build and package Windows IT review copy
call "OpenSayo\BUILD_WINDOWS_EXE.bat"
if errorlevel 1 (echo Build failed; no package created. & pause & exit /b 1)
if not exist "OpenSayo\dist\OpenSayo\OpenSayo.exe" (echo Missing Windows executable. & pause & exit /b 1)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $root=(Get-Location).Path; $stage=Join-Path $root 'Windows_IT_Review_Output'; if(Test-Path $stage){Remove-Item $stage -Recurse -Force}; New-Item $stage -ItemType Directory | Out-Null; Copy-Item (Join-Path $root 'OpenSayo\dist\OpenSayo') (Join-Path $stage 'OpenSayo') -Recurse; Copy-Item (Join-Path $root 'IT_Review') (Join-Path $stage 'IT_Review') -Recurse; New-Item (Join-Path $stage 'Source') -ItemType Directory | Out-Null; Copy-Item (Join-Path $root 'OpenSayo\py') (Join-Path $stage 'Source\py') -Recurse; Copy-Item (Join-Path $root 'OpenSayo\Tests') (Join-Path $stage 'Source\Tests') -Recurse; Copy-Item (Join-Path $root 'OpenSayo\OpenSayo.spec') (Join-Path $stage 'Source\OpenSayo.spec'); Copy-Item (Join-Path $root 'OpenSayo\BUILD_WINDOWS_EXE.bat') (Join-Path $stage 'Source\BUILD_WINDOWS_EXE.bat'); Copy-Item (Join-Path $root 'OpenSayo\OFFLINE_CHECK.bat') (Join-Path $stage 'Source\OFFLINE_CHECK.bat'); Copy-Item (Join-Path $root 'OpenSayo\RUN_OPENSAYO.bat') (Join-Path $stage 'Source\RUN_OPENSAYO.bat'); Copy-Item (Join-Path $root 'OpenSayo\Documentation') (Join-Path $stage 'Source\Documentation') -Recurse; Copy-Item (Join-Path $root 'OpenSayo\assets') (Join-Path $stage 'Source\assets') -Recurse; Copy-Item (Join-Path $root 'OpenSayo\OFFLINE_CHECK.bat') (Join-Path $stage 'Source\OFFLINE_CHECK.bat'); Copy-Item (Join-Path $root 'OpenSayo\RUN_OPENSAYO.bat') (Join-Path $stage 'Source\RUN_OPENSAYO.bat'); Copy-Item (Join-Path $root 'OpenSayo\Documentation') (Join-Path $stage 'Source\Documentation') -Recurse; Copy-Item (Join-Path $root 'OpenSayo\assets') (Join-Path $stage 'Source\assets') -Recurse; Copy-Item (Join-Path $root 'README.md') (Join-Path $stage 'README.md'); Get-ChildItem (Join-Path $stage 'Source') -Recurse -Directory -Filter '__pycache__' | Remove-Item -Recurse -Force; Get-ChildItem (Join-Path $stage 'Source') -Recurse -File -Filter '*.pyc' | Remove-Item -Force; $zip=Join-Path $root 'OpenSayo_v1.15_IT_Review_Windows.zip'; if(Test-Path $zip){Remove-Item $zip -Force}; Compress-Archive -Path (Join-Path $stage '*') -DestinationPath $zip; Write-Host ('Created '+$zip)"
if errorlevel 1 (echo Windows IT packaging failed. & pause & exit /b 1)
echo Windows executable and IT review ZIP created. Review and test before publication.
pause
endlocal
